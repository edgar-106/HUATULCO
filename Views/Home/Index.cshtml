@using System.Text.Json
@model IEnumerable<Alojamiento>
@{
    ViewData["Title"] = "Estancias & Experiencias";
    var conCoordenadas = Model
        .Where(a => a.Latitud.HasValue && a.Longitud.HasValue)
        .Select(a => new
        {
            name = a.Nombre,
            type = a.Tipo.ToString(),
            area = a.Direccion,
            price = (double)a.PrecioBasePorNoche,
            lat = a.Latitud!.Value,
            lng = a.Longitud!.Value,
            id = a.Id.ToString()
        })
        .ToList();
    var jsonPropiedades = JsonSerializer.Serialize(conCoordenadas);
    var totalUbicadas = conCoordenadas.Count;
}

<section class="map-hero" aria-label="Mapa aéreo interactivo de Huatulco">
    <div id="huatulco-map" class="huatulco-map" role="application" aria-label="Mapa satelital con la ubicación de los alojamientos"></div>
    <div class="map-shade"></div>
    
    <div class="map-copy">
        <p class="eyebrow">TU ESTANCIA EN HUATULCO</p>
        <h1>Del espacio<br>hasta Huatulco.</h1>
        <p>Encuentra dónde hospedarte y planea experiencias inolvidables junto al Pacífico.</p>
        <a class="button button-gold" asp-controller="Alojamientos" asp-action="Index">
            Explorar alojamientos <span>↗</span>
        </a>
    </div>

    <div class="map-location">
        <span class="location-pulse"></span>
        <div>
            <strong>HUATULCO, OAXACA</strong>
            <small>15°46′ N · 96°08′ O</small>
        </div>
    </div>

    <div class="map-counter">
        <span class="counter-dot"></span>
        <strong id="counter-count">@totalUbicadas</strong>
        <span>residencias ubicadas</span>
    </div>

    <div class="map-controls">
        <button type="button" id="map-zoom-in" aria-label="Acercar mapa">+</button>
        <button type="button" id="map-zoom-out" aria-label="Alejar mapa">−</button>
    </div>

    <div class="map-caption">IMAGEN SATELITAL · BAHÍAS DE HUATULCO</div>
</section>

@if (totalUbicadas == 0)
{
    <aside class="map-hint">
        <span>◎</span>
        <p>
            <strong>Las residencias aparecerán en este mapa.</strong>
            El administrador puede registrar las coordenadas de cada alojamiento desde el panel para ubicarlas con precisión.
        </p>
        <a asp-controller="Alojamientos" asp-action="Index">Ver alojamientos ↗</a>
    </aside>
}

<section class="featured section-wrap">
    <div class="section-heading">
        <div>
            <p class="eyebrow">DESCANSA CERCA DEL MAR</p>
            <h2>Lugares para descansar</h2>
        </div>
        <a class="text-link" asp-controller="Alojamientos" asp-action="Index">Ver todos <span>↗</span></a>
    </div>

    <div class="stay-grid">
        @if (!Model.Any())
        {
            <article class="empty-card">
                <span class="empty-icon">⌂</span>
                <h3>Muy pronto</h3>
                <p>Estamos preparando los primeros alojamientos para recibirte en las bahías.</p>
            </article>
            <article class="empty-card">
                <span class="empty-icon">⌂</span>
                <h3>Tu rincón en Huatulco</h3>
                <p>Casas, departamentos y habitaciones seleccionadas para cada viaje.</p>
            </article>
            <article class="empty-card">
                <span class="empty-icon">⌂</span>
                <h3>Experiencias locales</h3>
                <p>Hospedaje de calidad y actividades inolvidables en un solo lugar.</p>
            </article>
        }
        else
        {
            @foreach (var stay in Model.Take(6))
            {
                var bgStyle = !string.IsNullOrWhiteSpace(stay.ImagenPrincipalUrl)
                    ? $"background-image: linear-gradient(180deg, transparent 55%, rgba(13,28,33,.6)), url('{stay.ImagenPrincipalUrl}');"
                    : "background: linear-gradient(135deg, #18434c, #0a2127);";

                <a asp-controller="Alojamientos" asp-action="Detalle" asp-route-id="@stay.Id" class="stay-card" title="Ver toda la información de @stay.Nombre">
                    <div class="stay-image" style="@bgStyle">
                        <span class="stay-tag">@stay.Tipo</span>
                    </div>
                    <div class="stay-info">
                        <h3>@stay.Nombre</h3>
                        <p class="stay-specs">
                            @(string.IsNullOrWhiteSpace(stay.Direccion) ? "Bahías de Huatulco" : stay.Direccion) · @stay.CapacidadHuespedes huéspedes · @stay.NumeroHabitaciones hab. · @stay.NumeroBanos baños
                        </p>
                        <div class="stay-footer">
                            <strong>Desde @stay.PrecioBasePorNoche.ToString("C") <small>MXN por noche</small></strong>
                            <span class="text-link small" style="color: var(--sea); font-weight: 700;">Ver detalles ↗</span>
                        </div>
                    </div>
                </a>
            }
        }
    </div>
</section>

<section class="experience-strip" id="actividades">
    <div>
        <p class="eyebrow">MÁS QUE UN LUGAR PARA DORMIR</p>
        <h2>Arma tu experiencia en Huatulco</h2>
    </div>
    <p>Explora actividades, organiza tus días y coordina los detalles de tu estancia desde un solo lugar.</p>
    <a class="button button-dark" asp-controller="Alojamientos" asp-action="Index">
        Ver actividades <span>↗</span>
    </a>
</section>

@section Scripts {
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
(() => {
    const properties = @Html.Raw(jsonPropiedades);
    
    // Iniciar el mapa en altitud satelital
    const map = L.map('huatulco-map', {
        zoomControl: false,
        scrollWheelZoom: false,
        attributionControl: true
    }).setView([18, -102], 3);

    // Capa satelital de alta resolución ArcGIS Esri World Imagery
    L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
        maxZoom: 19,
        attribution: 'Tiles &copy; Esri — Source: Esri, Maxar, Earthstar Geographics'
    }).addTo(map);

    const huatulcoCoords = [15.775, -96.13];
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Animación de aproximación desde el espacio
    if (prefersReducedMotion) {
        map.setView(huatulcoCoords, properties.length ? 13 : 11);
    } else {
        window.setTimeout(() => {
            map.flyTo(huatulcoCoords, properties.length ? 13 : 11, {
                duration: 4.5,
                easeLinearity: 0.18
            });
        }, 450);
    }

    // Icono animado personalizado con pulso dorado
    const icon = L.divIcon({
        className: 'residence-marker-wrap',
        html: '<span class="residence-marker"><i></i></span>',
        iconSize: [34, 42],
        iconAnchor: [17, 38],
        popupAnchor: [0, -36]
    });

    // Colocar marcadores con popups
    properties.forEach((home) => {
        const marker = L.marker([home.lat, home.lng], { icon }).addTo(map);
        
        const popup = document.createElement('div');
        popup.className = 'residence-popup';
        
        const label = document.createElement('small');
        label.textContent = home.type + (home.area ? ' · ' + home.area : '');
        
        const title = document.createElement('strong');
        title.textContent = home.name;
        
        const price = document.createElement('span');
        price.textContent = 'Desde $' + new Intl.NumberFormat('es-MX').format(home.price) + ' MXN / noche';
        
        const link = document.createElement('a');
        link.href = '/Alojamientos/Detalle/' + home.id;
        link.textContent = 'Ver toda la información →';
        
        popup.append(label, title, price, link);
        marker.bindPopup(popup);
    });

    // Controles de zoom personalizados
    const zoomInBtn = document.getElementById('map-zoom-in');
    const zoomOutBtn = document.getElementById('map-zoom-out');
    if (zoomInBtn) zoomInBtn.addEventListener('click', () => map.zoomIn());
    if (zoomOutBtn) zoomOutBtn.addEventListener('click', () => map.zoomOut());
    
    window.addEventListener('resize', () => map.invalidateSize());
})();
</script>
}
