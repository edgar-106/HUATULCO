@using System.Text.Json
@model IEnumerable<Alojamiento>
@{
    ViewData["Title"] = "Estancias & Experiencias";
    var conCoordenadas = Model
        .Where(a => a.Latitud.HasValue && a.Longitud.HasValue)
        .Select(a => new
        {
            name = a.Nombre,
            type = a.Tipo.ToString(),
            area = a.Direccion,
            price = (double)a.PrecioBasePorNoche,
            lat = a.Latitud!.Value,
            lng = a.Longitud!.Value,
            id = a.Id.ToString()
        })
        .ToList();
    var jsonPropiedades = JsonSerializer.Serialize(conCoordenadas);
    var totalUbicadas = conCoordenadas.Count;
}

<section class="map-hero" aria-label="Mapa aéreo interactivo de Huatulco">
    <div id="huatulco-map" class="huatulco-map" role="application" aria-label="Mapa satelital con la ubicación de los alojamientos"></div>
    <div class="map-shade"></div>
    
    <div class="map-copy">
        <p class="eyebrow">TU ESTANCIA EN HUATULCO</p>
        <h1>Del espacio<br>hasta Huatulco.</h1>
        <p>Encuentra dónde hospedarte y planea experiencias inolvidables junto al Pacífico.</p>
        <a class="button button-gold" asp-controller="Alojamientos" asp-action="Index">
            Explorar alojamientos <span>↗</span>
        </a>
    </div>

    <div class="map-location">
        <span class="location-pulse"></span>
        <div>
            <strong>HUATULCO, OAXACA</strong>
            <small>15°46′ N · 96°08′ O</small>
        </div>
    </div>

    <div class="map-counter">
        <span class="counter-dot"></span>
        <strong id="counter-count">@totalUbicadas</strong>
        <span>residencias ubicadas</span>
    </div>

    <div class="map-controls">
        <button type="button" id="map-zoom-in" aria-label="Acercar mapa">+</button>
        <button type="button" id="map-zoom-out" aria-label="Alejar mapa">−</button>
    </div>

    <div class="map-caption">IMAGEN SATELITAL · BAHÍAS DE HUATULCO</div>
</section>

@if (totalUbicadas == 0)
{
    <aside class="map-hint">
        <span>◎</span>
        <p>
            <strong>Las residencias aparecerán en este mapa.</strong>
            El administrador puede registrar las coordenadas de cada alojamiento desde el panel para ubicarlas con precisión.
        </p>
        <a asp-controller="Alojamientos" asp-action="Index">Ver alojamientos ↗</a>
    </aside>
}

<section class="featured section-wrap">
    <div class="section-heading">
        <div>
            <p class="eyebrow">DESCANSA CERCA DEL MAR</p>
            <h2>Lugares para descansar</h2>
        </div>
        <a class="text-link" asp-controller="Alojamientos" asp-action="Index">Ver todos <span>↗</span></a>
    </div>

    <div class="stay-grid" style="gap: 32px;">
        @if (!Model.Any())
        {
            <article class="empty-card">
                <span class="empty-icon">⌂</span>
                <h3>Muy pronto</h3>
                <p>Estamos preparando los primeros alojamientos para recibirte en las bahías.</p>
            </article>
            <article class="empty-card">
                <span class="empty-icon">⌂</span>
                <h3>Tu rincón en Huatulco</h3>
                <p>Casas, departamentos y habitaciones seleccionadas para cada viaje.</p>
            </article>
            <article class="empty-card">
                <span class="empty-icon">⌂</span>
                <h3>Experiencias locales</h3>
                <p>Hospedaje de calidad y actividades inolvidables en un solo lugar.</p>
            </article>
        }
        else
        {
            @foreach (var stay in Model.Take(6))
            {
                var bgStyle = !string.IsNullOrWhiteSpace(stay.ImagenPrincipalUrl)
                    ? $"background-image: linear-gradient(180deg, transparent 55%, rgba(13,28,33,.6)), url('{stay.ImagenPrincipalUrl}');"
                    : "background: linear-gradient(135deg, #18434c, #0a2127);";

                var listaFotos = stay.Imagenes != null && stay.Imagenes.Any()
                    ? stay.Imagenes.OrderBy(x => x.Orden).Select(x => x.RutaArchivo).ToList()
                    : new List<string> { stay.ImagenPrincipalUrl ?? "https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=1400&q=80" };
                
                var fotosJson = JsonSerializer.Serialize(listaFotos);

                <a href="@Url.Action("Detalle", "Alojamientos", new { id = stay.Id })" class="stay-card text-decoration-none" title="Ver información completa de @stay.Nombre">
                    <div class="stay-image" style="@bgStyle">
                        <span class="stay-tag">@stay.Tipo</span>
                        
                        <!-- Botones de Fotos y Recorrido 3D en la tarjeta -->
                        <div class="card-floating-actions" onclick="event.preventDefault(); event.stopPropagation();">
                            <button type="button" class="btn-card-action" onclick="event.preventDefault(); event.stopPropagation(); abrirGaleriaModal('@stay.Nombre', @fotosJson)" title="Ver fotos del alojamiento">
                                📷 Fotos
                            </button>
                            <button type="button" class="btn-card-action" onclick="event.preventDefault(); event.stopPropagation(); abrirTour3DModal('@stay.Nombre', '@stay.Tipo')" title="Abrir recorrido 3D interactivo">
                                🌐 Recorrido 3D
                            </button>
                        </div>
                    </div>

                    <div class="stay-info">
                        <h3>@stay.Nombre</h3>
                        <p class="stay-specs">
                            @(string.IsNullOrWhiteSpace(stay.Direccion) ? "Bahías de Huatulco" : stay.Direccion) · @stay.CapacidadHuespedes huéspedes · @stay.NumeroHabitaciones hab. · @stay.NumeroBanos baños
                        </p>
                        
                        <div class="stay-footer">
                            <strong>Desde @stay.PrecioBasePorNoche.ToString("C") <small>MXN por noche</small></strong>
                            <span class="text-link small" style="color: var(--sea); font-weight: 700;">Ver detalles ↗</span>
                        </div>
                    </div>
                </a>
            }
        }
    </div>
</section>

<section class="experience-strip" id="actividades">
    <div>
        <p class="eyebrow">MÁS QUE UN LUGAR PARA DORMIR</p>
        <h2>Arma tu experiencia en Huatulco</h2>
    </div>
    <p>Explora actividades, organiza tus días y coordina los detalles de tu estancia desde un solo lugar.</p>
    <a class="button button-dark" asp-controller="Alojamientos" asp-action="Index">
        Ver actividades <span>↗</span>
    </a>
</section>

<!-- ==========================================================================
     MODAL DE GALERÍA DE IMÁGENES
     ========================================================================== -->
<div class="modal fade" id="modalGaleriaFotos" tabindex="-1" aria-labelledby="modalGaleriaFotosLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 overflow-hidden shadow-lg" style="background: #10272c; color: #fff;">
            <div class="modal-header border-0 pb-0 px-4 pt-4">
                <div>
                    <span class="eyebrow" style="color: var(--sand);">GALERÍA FOTOGRÁFICA</span>
                    <h5 class="modal-title h4 fw-bold" id="modalGaleriaTitulo" style="font-family: 'Playfair Display', serif;">Fotos del alojamiento</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <div class="position-relative rounded-4 overflow-hidden mb-3 bg-black d-flex align-items-center justify-content-center" style="height: 440px;">
                    <img id="imgGaleriaPrincipal" src="" alt="Fotografía" class="w-100 h-100 object-fit-cover" />
                    
                    <button type="button" class="btn-tour-ctrl position-absolute start-0 ms-3 top-50 translate-middle-y" onclick="anteriorFoto()" aria-label="Foto anterior">
                        ❮
                    </button>
                    <button type="button" class="btn-tour-ctrl position-absolute end-0 me-3 top-50 translate-middle-y" onclick="siguienteFoto()" aria-label="Siguiente foto">
                        ❯
                    </button>
                    
                    <span id="contadorFotos" class="position-absolute bottom-0 start-50 translate-middle-x mb-3 px-3 py-1 rounded-pill small" style="background: rgba(0,0,0,.65); backdrop-filter: blur(6px); font-size: 11px;">
                        1 / 1
                    </span>
                </div>
                
                <div id="tiraMiniaturas" class="d-flex gap-2 overflow-auto pb-2"></div>
            </div>
        </div>
    </div>
</div>

<!-- ==========================================================================
     MODAL DE RECORRIDO INTERACTIVO 3D (360° WebGL Three.js)
     ========================================================================== -->
<div class="modal fade" id="modalTour3D" tabindex="-1" aria-labelledby="modalTour3DLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content rounded-4 border-0 overflow-hidden shadow-lg" style="background: #09171b; color: #fff;">
            <div class="modal-header border-0 pb-0 px-4 pt-4">
                <div>
                    <span class="eyebrow" style="color: var(--sand);">RECORRIDO INMERSIVO 360°</span>
                    <h5 class="modal-title h4 fw-bold" id="modalTourTitulo" style="font-family: 'Playfair Display', serif;">Recorrido 3D</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            
            <div class="modal-body p-4">
                <div class="tour-3d-box">
                    <div id="tour3d-canvas-container" class="tour-3d-canvas-wrap"></div>
                    
                    <div class="tour-3d-overlay">
                        <div class="tour-top-bar">
                            <span class="tour-badge-3d">
                                <span class="pulse-3d"></span>
                                VISTA VIRTUAL 360°
                            </span>
                            
                            <div class="tour-rooms-nav">
                                <button type="button" class="btn-tour-room active" onclick="cambiarAmbiente3D(0, this)">🛋️ Sala</button>
                                <button type="button" class="btn-tour-room" onclick="cambiarAmbiente3D(1, this)">🛏️ Recámara</button>
                                <button type="button" class="btn-tour-room" onclick="cambiarAmbiente3D(2, this)">🌊 Alberca / Mar</button>
                            </div>
                        </div>
                        
                        <div class="tour-bottom-bar">
                            <span class="tour-hint d-none d-sm-inline">
                                👆 Arrastra para girar 360° · Rueda de mouse o pellizco para zoom
                            </span>
                            
                            <div class="tour-quick-controls">
                                <button type="button" class="btn-tour-ctrl" onclick="zoomTour(1)" title="Acercar">＋</button>
                                <button type="button" class="btn-tour-ctrl" onclick="zoomTour(-1)" title="Alejar">－</button>
                                <button type="button" class="btn-tour-ctrl" id="btnToggleGiro" onclick="toggleAutoGiro()" title="Activar/Desactivar giro automático">↻</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
(() => {
    const properties = @Html.Raw(jsonPropiedades);
    
    // Iniciar el mapa en altitud satelital
    const map = L.map('huatulco-map', {
        zoomControl: false,
        scrollWheelZoom: false,
        attributionControl: true
    }).setView([18, -102], 3);

    // Capa satelital de alta resolución ArcGIS Esri World Imagery
    L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
        maxZoom: 19,
        attribution: 'Tiles &copy; Esri — Source: Esri, Maxar, Earthstar Geographics'
    }).addTo(map);

    const huatulcoCoords = [15.775, -96.13];
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Animación de aproximación desde el espacio
    if (prefersReducedMotion) {
        map.setView(huatulcoCoords, properties.length ? 13 : 11);
    } else {
        window.setTimeout(() => {
            map.flyTo(huatulcoCoords, properties.length ? 13 : 11, {
                duration: 4.5,
                easeLinearity: 0.18
            });
        }, 450);
    }

    // Icono animado personalizado con pulso dorado
    const icon = L.divIcon({
        className: 'residence-marker-wrap',
        html: '<span class="residence-marker"><i></i></span>',
        iconSize: [34, 42],
        iconAnchor: [17, 38],
        popupAnchor: [0, -36]
    });

    // Colocar marcadores con popups
    properties.forEach((home) => {
        const marker = L.marker([home.lat, home.lng], { icon }).addTo(map);
        
        const popup = document.createElement('div');
        popup.className = 'residence-popup';
        
        const label = document.createElement('small');
        label.textContent = home.type + (home.area ? ' · ' + home.area : '');
        
        const title = document.createElement('strong');
        title.textContent = home.name;
        
        const price = document.createElement('span');
        price.textContent = 'Desde $' + new Intl.NumberFormat('es-MX').format(home.price) + ' MXN / noche';
        
        const link = document.createElement('a');
        link.href = '/Alojamientos/Detalle/' + home.id;
        link.textContent = 'Ver toda la información →';
        
        popup.append(label, title, price, link);
        marker.bindPopup(popup);
    });

    // Controles de zoom personalizados
    const zoomInBtn = document.getElementById('map-zoom-in');
    const zoomOutBtn = document.getElementById('map-zoom-out');
    if (zoomInBtn) zoomInBtn.addEventListener('click', () => map.zoomIn());
    if (zoomOutBtn) zoomOutBtn.addEventListener('click', () => map.zoomOut());
    
    window.addEventListener('resize', () => map.invalidateSize());
})();

// ==========================================================================
// MODAL DE FOTOS
// ==========================================================================
let fotosActuales = [];
let fotoIndiceActual = 0;

function abrirGaleriaModal(nombre, listaFotos) {
    document.getElementById('modalGaleriaTitulo').textContent = nombre;
    fotosActuales = (listaFotos && listaFotos.length > 0) ? listaFotos : [];
    fotoIndiceActual = 0;
    
    // Generar miniaturas
    const tira = document.getElementById('tiraMiniaturas');
    tira.innerHTML = '';
    
    fotosActuales.forEach((src, idx) => {
        const img = document.createElement('img');
        img.src = src;
        img.alt = `Miniatura ${idx + 1}`;
        img.className = 'rounded-3 object-fit-cover border ' + (idx === 0 ? 'border-warning border-2' : 'border-secondary opacity-75');
        img.style.width = '70px';
        img.style.height = '50px';
        img.style.cursor = 'pointer';
        img.onclick = () => {
            fotoIndiceActual = idx;
            actualizarVisorGaleria();
        };
        tira.appendChild(img);
    });

    actualizarVisorGaleria();
    const modal = new bootstrap.Modal(document.getElementById('modalGaleriaFotos'));
    modal.show();
}

function actualizarVisorGaleria() {
    if (!fotosActuales.length) return;
    document.getElementById('imgGaleriaPrincipal').src = fotosActuales[fotoIndiceActual];
    document.getElementById('contadorFotos').textContent = `${fotoIndiceActual + 1} / ${fotosActuales.length}`;
    
    const thumbs = document.querySelectorAll('#tiraMiniaturas img');
    thumbs.forEach((th, i) => {
        th.className = (i === fotoIndiceActual)
            ? 'rounded-3 object-fit-cover border border-warning border-2'
            : 'rounded-3 object-fit-cover border border-secondary opacity-75';
    });
}

function siguienteFoto() {
    if (!fotosActuales.length) return;
    fotoIndiceActual = (fotoIndiceActual + 1) % fotosActuales.length;
    actualizarVisorGaleria();
}

function anteriorFoto() {
    if (!fotosActuales.length) return;
    fotoIndiceActual = (fotoIndiceActual - 1 + fotosActuales.length) % fotosActuales.length;
    actualizarVisorGaleria();
}

// ==========================================================================
// RECORRIDO 3D INTERACTIVO CON THREE.JS (PANORAMA ESFÉRICO 360°)
// ==========================================================================
let scene3d, camera3d, renderer3d, sphereMesh, isUserInteracting = false;
let onPointerDownMouseX = 0, onPointerDownMouseY = 0;
let lon = 0, onPointerDownLon = 0, lat = 0, onPointerDownLat = 0;
let phi = 0, theta = 0, autoRotate = true;

const panoramas = [
    'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=2400&q=85',
    'https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=2400&q=85',
    'https://images.unsplash.com/photo-1580587771525-78b9dba3b914?auto=format&fit=crop&w=2400&q=85'
];

function abrirTour3DModal(nombre, tipo) {
    document.getElementById('modalTourTitulo').textContent = `${nombre} (${tipo})`;
    const modalEl = document.getElementById('modalTour3D');
    const modal = new bootstrap.Modal(modalEl);
    modal.show();

    modalEl.addEventListener('shown.bs.modal', function onShown() {
        initThreeJsTour();
        modalEl.removeEventListener('shown.bs.modal', onShown);
    });
}

function initThreeJsTour() {
    const container = document.getElementById('tour3d-canvas-container');
    container.innerHTML = '';

    const width = container.clientWidth;
    const height = container.clientHeight;

    scene3d = new THREE.Scene();
    camera3d = new THREE.PerspectiveCamera(75, width / height, 1, 1100);
    camera3d.target = new THREE.Vector3(0, 0, 0);

    const geometry = new THREE.SphereGeometry(500, 60, 40);
    geometry.scale(-1, 1, 1);

    const textureLoader = new THREE.TextureLoader();
    const texture = textureLoader.load(panoramas[0]);
    const material = new THREE.MeshBasicMaterial({ map: texture });
    sphereMesh = new THREE.Mesh(geometry, material);
    scene3d.add(sphereMesh);

    renderer3d = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer3d.setPixelRatio(window.devicePixelRatio);
    renderer3d.setSize(width, height);
    container.appendChild(renderer3d.domElement);

    container.addEventListener('pointerdown', onPointerDown);
    container.addEventListener('wheel', onDocumentMouseWheel, { passive: true });
    window.addEventListener('resize', onTourResize);

    animateTour();
}

function cambiarAmbiente3D(indice, btn) {
    if (!sphereMesh) return;
    const loader = new THREE.TextureLoader();
    loader.load(panoramas[indice], (tex) => {
        sphereMesh.material.map = tex;
        sphereMesh.material.needsUpdate = true;
    });

    document.querySelectorAll('.btn-tour-room').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');
}

function onPointerDown(event) {
    if (event.isPrimary === false) return;
    isUserInteracting = true;
    onPointerDownMouseX = event.clientX;
    onPointerDownMouseY = event.clientY;
    onPointerDownLon = lon;
    onPointerDownLat = lat;

    document.addEventListener('pointermove', onPointerMove);
    document.addEventListener('pointerup', onPointerUp);
}

function onPointerMove(event) {
    if (event.isPrimary === false) return;
    lon = (onPointerDownMouseX - event.clientX) * 0.15 + onPointerDownLon;
    lat = (event.clientY - onPointerDownMouseY) * 0.15 + onPointerDownLat;
}

function onPointerUp(event) {
    if (event.isPrimary === false) return;
    isUserInteracting = false;
    document.removeEventListener('pointermove', onPointerMove);
    document.removeEventListener('pointerup', onPointerUp);
}

function onDocumentMouseWheel(event) {
    if (!camera3d) return;
    const fov = camera3d.fov + event.deltaY * 0.05;
    camera3d.fov = THREE.MathUtils.clamp(fov, 35, 95);
    camera3d.updateProjectionMatrix();
}

function zoomTour(delta) {
    if (!camera3d) return;
    camera3d.fov = THREE.MathUtils.clamp(camera3d.fov - delta * 10, 35, 95);
    camera3d.updateProjectionMatrix();
}

function toggleAutoGiro() {
    autoRotate = !autoRotate;
    const btn = document.getElementById('btnToggleGiro');
    if (btn) btn.style.background = autoRotate ? 'var(--sand)' : 'rgba(14, 39, 45, .82)';
}

function onTourResize() {
    const container = document.getElementById('tour3d-canvas-container');
    if (!container || !renderer3d || !camera3d) return;
    camera3d.aspect = container.clientWidth / container.clientHeight;
    camera3d.updateProjectionMatrix();
    renderer3d.setSize(container.clientWidth, container.clientHeight);
}

function animateTour() {
    if (!renderer3d || !scene3d || !camera3d) return;
    requestAnimationFrame(animateTour);

    if (autoRotate && !isUserInteracting) {
        lon += 0.08;
    }

    lat = Math.max(-85, Math.min(85, lat));
    phi = THREE.MathUtils.degToRad(90 - lat);
    theta = THREE.MathUtils.degToRad(lon);

    const x = 500 * Math.sin(phi) * Math.cos(theta);
    const y = 500 * Math.cos(phi);
    const z = 500 * Math.sin(phi) * Math.sin(theta);

    camera3d.lookAt(x, y, z);
    renderer3d.render(scene3d, camera3d);
}
</script>
}
