<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HuatulcoTravel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark site-navbar">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">HuatulcoTravel</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Alojamientos" asp-action="Index">Alojamientos</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Experiencias</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Contacto</a></li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Alojamientos" asp-action="Index">Administración</a></li>
                        }
                        <li class="nav-item">
                            <form asp-controller="Cuenta" asp-action="Salir" method="post">
                                <button class="btn btn-link nav-link" type="submit">Cerrar sesión</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Cuenta" asp-action="Ingresar">Ingresar</a></li>
<li class="nav-item"><a class="nav-link" asp-controller="Cuenta" asp-action="Registro">Crear cuenta</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
<main role="main">
    @RenderBody()
</main>
<footer class="border-top footer text-muted py-4 mt-5">
    <div class="container">© @DateTime.Now.Year HuatulcoTravel. Todos los derechos reservados.</div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
