@model IEnumerable<Alojamiento>
@{
    ViewData["Title"] = "Alojamientos";
}

<section class="section-wrap">
    <div class="section-heading">
        <div>
            <p class="eyebrow">CATÁLOGO EXCLUSIVO</p>
            <h2>Alojamientos en Bahías de Huatulco</h2>
        </div>
    </div>

    <div class="stay-grid">
        @if (!Model.Any())
        {
            <article class="empty-card">
                <span class="empty-icon">⌂</span>
                <h3>Sin alojamientos publicados</h3>
                <p>Actualmente no hay estancias activas para mostrar en el catálogo.</p>
            </article>
        }
        else
        {
            @foreach (var stay in Model)
            {
                var bgStyle = !string.IsNullOrWhiteSpace(stay.ImagenPrincipalUrl)
                    ? $"background-image: linear-gradient(180deg, transparent 55%, rgba(13,28,33,.6)), url('{stay.ImagenPrincipalUrl}');"
                    : "background: linear-gradient(135deg, #18434c, #0a2127);";

                <a asp-controller="Alojamientos" asp-action="Detalle" asp-route-id="@stay.Id" class="stay-card" title="Ver toda la información de @stay.Nombre">
                    <div class="stay-image" style="@bgStyle">
                        <span class="stay-tag">@stay.Tipo</span>
                    </div>
                    <div class="stay-info">
                        <h3>@stay.Nombre</h3>
                        <p class="mb-3">
                            @(string.IsNullOrWhiteSpace(stay.Direccion) ? "Bahías de Huatulco" : stay.Direccion) · @stay.CapacidadHuespedes huéspedes · @stay.NumeroHabitaciones hab. · @stay.NumeroBanos baños
                        </p>
                        <div class="d-flex justify-content-between align-items-baseline mt-auto">
                            <strong>Desde @stay.PrecioBasePorNoche.ToString("C") <small>MXN / noche</small></strong>
                            <span class="text-link small" style="color: var(--sea); font-weight: 700;">Ver detalles ↗</span>
                        </div>
                    </div>
                </a>
            }
        }
    </div>
</section>
