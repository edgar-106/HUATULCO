@model Alojamiento
@{
    ViewData["Title"] = Model.Nombre;
    var hasCoords = Model.Latitud.HasValue && Model.Longitud.HasValue;
}

<div class="section-wrap" style="padding-top: 40px;">
    <!-- Migas de pan / Regresar -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0" style="font-size: 13px;">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" style="color: var(--sea); text-decoration: none;">Inicio</a></li>
                <li class="breadcrumb-item"><a asp-controller="Alojamientos" asp-action="Index" style="color: var(--sea); text-decoration: none;">Alojamientos</a></li>
                <li class="breadcrumb-item active text-muted" aria-current="page">@Model.Nombre</li>
            </ol>
        </nav>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
            ← Volver al catálogo
        </a>
    </div>

    <!-- Título y Encabezado -->
    <div class="mb-4">
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="stay-tag position-static d-inline-block">@Model.Tipo</span>
            <span class="text-muted small">· Bahías de Huatulco, Oaxaca</span>
        </div>
        <h1 class="display-5 fw-bold" style="font-family: 'Playfair Display', serif; color: var(--deep);">@Model.Nombre</h1>
        <p class="text-muted mb-0">
            📍 @(string.IsNullOrWhiteSpace(Model.Direccion) ? "Bahías de Huatulco, Oaxaca, México" : Model.Direccion)
        </p>
    </div>

    <!-- Galería / Imagen Principal -->
    <div class="row g-3 mb-5">
        <div class="@(Model.Imagenes.Any() ? "col-lg-8" : "col-12")">
            <div class="rounded-4 overflow-hidden shadow-sm" style="height: 460px; background-color: #c5d2ce; background-position: center; background-size: cover; background-image: url('@(string.IsNullOrWhiteSpace(Model.ImagenPrincipalUrl) ? "https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=1400&q=80" : Model.ImagenPrincipalUrl)');">
            </div>
        </div>
        @if (Model.Imagenes.Any())
        {
            <div class="col-lg-4">
                <div class="d-flex flex-column gap-3 h-100">
                    @foreach (var img in Model.Imagenes.Take(2))
                    {
                        <div class="rounded-4 overflow-hidden shadow-sm flex-fill" style="min-height: 215px; background-color: #c5d2ce; background-position: center; background-size: cover; background-image: url('@img.RutaArchivo');"></div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Contenido y Tarjeta de Reserva -->
    <div class="row g-5">
        <!-- Columna Principal: Detalles y Descripción -->
        <div class="col-lg-8">
            <!-- Barra de Características Principales -->
            <div class="p-4 rounded-4 bg-white border mb-4 d-flex flex-wrap justify-content-around gap-3 text-center shadow-sm">
                <div>
                    <span class="d-block text-muted small text-uppercase fw-bold">Capacidad</span>
                    <strong class="fs-5" style="color: var(--deep);">👥 @Model.CapacidadHuespedes huéspedes</strong>
                </div>
                <div class="border-start ps-3 d-none d-sm-block"></div>
                <div>
                    <span class="d-block text-muted small text-uppercase fw-bold">Habitaciones</span>
                    <strong class="fs-5" style="color: var(--deep);">🛏️ @Model.NumeroHabitaciones recámaras</strong>
                </div>
                <div class="border-start ps-3 d-none d-sm-block"></div>
                <div>
                    <span class="d-block text-muted small text-uppercase fw-bold">Baños</span>
                    <strong class="fs-5" style="color: var(--deep);">🚿 @Model.NumeroBanos baños</strong>
                </div>
                <div class="border-start ps-3 d-none d-sm-block"></div>
                <div>
                    <span class="d-block text-muted small text-uppercase fw-bold">Tipo de Estancia</span>
                    <strong class="fs-5" style="color: var(--deep);">🏝️ @Model.Tipo</strong>
                </div>
            </div>

            <!-- Descripción Completa -->
            <div class="mb-5">
                <h2 class="h3 fw-bold mb-3" style="font-family: 'Playfair Display', serif; color: var(--deep);">Acerca de este alojamiento</h2>
                <div class="fs-6 lh-lg text-secondary" style="white-space: pre-line;">
                    @Model.Descripcion
                </div>
            </div>

            <!-- Servicios Incluidos -->
            <div class="mb-5 p-4 rounded-4 bg-white border shadow-sm">
                <h3 class="h4 fw-bold mb-3" style="font-family: 'Playfair Display', serif; color: var(--deep);">Lo que ofrece este lugar</h3>
                <div class="row g-3 text-secondary">
                    <div class="col-sm-6">✓ Vista al mar o entorno natural</div>
                    <div class="col-sm-6">✓ Aire acondicionado en habitaciones</div>
                    <div class="col-sm-6">✓ Conexión Wi-Fi de alta velocidad</div>
                    <div class="col-sm-6">✓ Toallas y sábanas de algodón</div>
                    <div class="col-sm-6">✓ Cocina o área para preparar alimentos</div>
                    <div class="col-sm-6">✓ Estacionamiento seguro incluido</div>
                </div>
            </div>

            <!-- Mapa de Ubicación -->
            @if (hasCoords)
            {
                <div class="mb-5">
                    <h3 class="h4 fw-bold mb-2" style="font-family: 'Playfair Display', serif; color: var(--deep);">Ubicación en Bahías de Huatulco</h3>
                    <p class="text-muted small mb-3">Coordenadas satelitales: @Model.Latitud, @Model.Longitud · @Model.Direccion</p>
                    <div id="detail-map" class="rounded-4 overflow-hidden border shadow-sm" style="height: 380px;"></div>
                </div>
            }
        </div>

        <!-- Columna Lateral: Tarjeta Flotante de Reserva / Contacto -->
        <div class="col-lg-4">
            <div class="sticky-top" style="top: 105px;">
                <div class="auth-card p-4 shadow-sm" style="max-width: 100%;">
                    <div class="d-flex justify-content-between align-items-baseline mb-3">
                        <span class="fs-3 fw-bold text-dark" style="color: #ae8c4c !important;">
                            @Model.PrecioBasePorNoche.ToString("C")
                        </span>
                        <span class="text-muted small">MXN / noche</span>
                    </div>

                    <div class="p-3 rounded-3 bg-light border mb-3 small">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Alojamiento:</span>
                            <strong>@Model.Tipo</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Capacidad máx:</span>
                            <strong>Hasta @Model.CapacidadHuespedes personas</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Disponibilidad:</span>
                            <span class="badge bg-success-subtle text-success">Disponible</span>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mb-3">
                        <a href="https://wa.me/?text=@Uri.EscapeDataString($"Hola, deseo información y reservar en {Model.Nombre} en Bahías de Huatulco.")" target="_blank" class="button button-gold w-100 text-center">
                            Solicitar Reservación <span>↗</span>
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="button button-outline text-center text-dark" style="border-color: #ced2cd; color: var(--ink) !important;">
                            Explorar experiencias
                        </a>
                    </div>

                    <p class="text-muted small text-center mb-0" style="font-size: 11px;">
                        🔒 Apartado protegido durante 3 días. Sin cargos sorpresa.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@if (hasCoords)
{
    @section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
    (() => {
        const lat = @Model.Latitud!.Value;
        const lng = @Model.Longitud!.Value;
        
        const map = L.map('detail-map', {
            zoomControl: true,
            scrollWheelZoom: false
        }).setView([lat, lng], 15);

        L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
            maxZoom: 19,
            attribution: 'Tiles &copy; Esri — Source: Esri, Maxar'
        }).addTo(map);

        const icon = L.divIcon({
            className: 'residence-marker-wrap',
            html: '<span class="residence-marker"><i></i></span>',
            iconSize: [34, 42],
            iconAnchor: [17, 38],
            popupAnchor: [0, -36]
        });

        const marker = L.marker([lat, lng], { icon }).addTo(map);
        marker.bindPopup(`<strong>@Model.Nombre</strong><br><small>@Model.Direccion</small>`).openPopup();
    })();
    </script>
    }
}
