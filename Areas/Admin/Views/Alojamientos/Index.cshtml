@model IEnumerable<Alojamiento>
@{
    ViewData["Title"] = "Panel de Administración - Alojamientos";
    bool inactive = ViewBag.IncluirInactivos == true;
    var total = Model.Count();
    var activos = Model.Count(a => a.Activo);
    var promedio = total > 0 ? Model.Average(a => (double)a.PrecioBasePorNoche) : 0;
    var totalHuespedes = Model.Where(a => a.Activo).Sum(a => a.CapacidadHuespedes);
}

<div class="section-wrap" style="padding-top: 36px; padding-bottom: 70px;">
    <!-- Encabezado del Panel -->
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="stay-tag position-static d-inline-block">PANEL ADMINISTRATIVO</span>
                <span class="text-muted small">· HuatulcoTravel Management</span>
            </div>
            <h1 class="display-6 fw-bold mb-1" style="font-family: 'Playfair Display', serif; color: var(--deep);">
                Control de Alojamientos
            </h1>
            <p class="text-muted mb-0 small">
                Supervisa y administra el catálogo oficial de residencias, tarifas y disponibilidad en Bahías de Huatulco.
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (inactive)
            {
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 py-2 small fw-semibold">
                    👁️ Ver solo activos
                </a>
            }
            else
            {
                <a asp-action="Index" asp-route-incluirInactivos="true" class="btn btn-outline-secondary rounded-pill px-3 py-2 small fw-semibold">
                    📋 Incluir bajas
                </a>
            }
            <a asp-action="Crear" class="button button-gold rounded-pill px-4 py-2 d-inline-flex align-items-center gap-2 shadow-sm text-decoration-none">
                <span>＋</span> Registrar nuevo alojamiento
            </a>
        </div>
    </div>

    <!-- Alerta de Notificación si existe -->
    @if (TempData["Mensaje"] is string msg)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm p-3 mb-4 d-flex align-items-center gap-3" role="alert" style="background: #e6f6ee; color: #155724;">
            <span class="fs-4">✓</span>
            <div class="fw-semibold">@msg</div>
            <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- Tarjetas KPI / Métricas Rápidas -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="p-3 rounded-4 bg-white border shadow-sm">
                <span class="d-block text-muted small text-uppercase fw-bold" style="font-size: 11px;">Total Registrados</span>
                <div class="d-flex align-items-baseline justify-content-between mt-1">
                    <strong class="fs-3" style="color: var(--deep);">@total</strong>
                    <span class="badge bg-secondary-subtle text-secondary rounded-pill">Propiedades</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="p-3 rounded-4 bg-white border shadow-sm">
                <span class="d-block text-muted small text-uppercase fw-bold" style="font-size: 11px;">Activos en Catálogo</span>
                <div class="d-flex align-items-baseline justify-content-between mt-1">
                    <strong class="fs-3 text-success">@activos</strong>
                    <span class="badge bg-success-subtle text-success rounded-pill">Visibles</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="p-3 rounded-4 bg-white border shadow-sm">
                <span class="d-block text-muted small text-uppercase fw-bold" style="font-size: 11px;">Tarifa Promedio</span>
                <div class="d-flex align-items-baseline justify-content-between mt-1">
                    <strong class="fs-3" style="color: #ae8c4c;">@promedio.ToString("C0")</strong>
                    <span class="text-muted small">MXN / noche</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="p-3 rounded-4 bg-white border shadow-sm">
                <span class="d-block text-muted small text-uppercase fw-bold" style="font-size: 11px;">Capacidad Total</span>
                <div class="d-flex align-items-baseline justify-content-between mt-1">
                    <strong class="fs-3" style="color: var(--sea);">@totalHuespedes</strong>
                    <span class="badge bg-primary-subtle text-primary rounded-pill">Huéspedes</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla Principal de Gestión -->
    <div class="card border-0 rounded-4 shadow-sm overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 14px;">
                <thead style="background: #f7faf9; border-bottom: 2px solid var(--line);">
                    <tr>
                        <th class="ps-4 py-3 text-uppercase text-muted fw-bold" style="font-size: 11px; letter-spacing: .5px;">Alojamiento</th>
                        <th class="py-3 text-uppercase text-muted fw-bold" style="font-size: 11px; letter-spacing: .5px;">Tipo</th>
                        <th class="py-3 text-uppercase text-muted fw-bold" style="font-size: 11px; letter-spacing: .5px;">Distribución</th>
                        <th class="py-3 text-uppercase text-muted fw-bold" style="font-size: 11px; letter-spacing: .5px;">Precio / Noche</th>
                        <th class="py-3 text-uppercase text-muted fw-bold text-center" style="font-size: 11px; letter-spacing: .5px;">Estado</th>
                        <th class="pe-4 py-3 text-uppercase text-muted fw-bold text-end" style="font-size: 11px; letter-spacing: .5px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        var thumbUrl = !string.IsNullOrWhiteSpace(a.ImagenPrincipalUrl)
                            ? a.ImagenPrincipalUrl
                            : "https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=150&q=80";

                        <tr style="@(!a.Activo ? "opacity: 0.6; background: #fafafa;" : "")">
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-3 overflow-hidden flex-shrink-0 shadow-sm" style="width: 54px; height: 54px; background: url('@thumbUrl') center/cover #ddd;"></div>
                                    <div>
                                        <strong class="d-block text-dark" style="font-family: 'Playfair Display', serif; font-size: 16px;">@a.Nombre</strong>
                                        <small class="text-muted d-block text-truncate" style="max-width: 280px;">📍 @(string.IsNullOrWhiteSpace(a.Direccion) ? "Bahías de Huatulco" : a.Direccion)</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background: #eef5f5; color: var(--sea); font-size: 11px;">
                                    @a.Tipo
                                </span>
                            </td>
                            <td>
                                <div class="small text-muted">
                                    <span>👥 @a.CapacidadHuespedes pers</span> · 
                                    <span>🛏️ @a.NumeroHabitaciones hab</span> · 
                                    <span>🚿 @a.NumeroBanos bñ</span>
                                </div>
                            </td>
                            <td>
                                <strong class="fs-6" style="color: #ae8c4c;">@a.PrecioBasePorNoche.ToString("C")</strong>
                                <span class="text-muted small d-block" style="font-size: 11px;">por noche</span>
                            </td>
                            <td class="text-center">
                                @if (a.Activo)
                                {
                                    <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2 fw-bold">
                                        ● @a.Estado
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-2 fw-bold">
                                        Inactivo
                                    </span>
                                }
                            </td>
                            <td class="pe-4 text-end text-nowrap">
                                <div class="d-inline-flex gap-1">
                                    <a asp-controller="Alojamientos" asp-action="Detalle" asp-area="" asp-route-id="@a.Id" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1" title="Ver ficha pública en la web">
                                        👁️
                                    </a>
                                    @if (a.Activo)
                                    {
                                        <a asp-action="Editar" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-semibold">
                                            ✏️ Editar
                                        </a>
                                        <form asp-action="Desactivar" asp-route-id="@a.Id" method="post" class="d-inline" onsubmit="return confirm('¿Desactivar @a.Nombre? Se conservará su historial de reservas.');">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1" title="Dar de baja">
                                                🗑️
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="p-5 text-center text-muted">
                    <span class="display-4 d-block mb-2">🏖️</span>
                    <h4 class="fw-bold">No hay alojamientos registrados</h4>
                    <p class="small text-muted mb-3">Comienza creando una nueva residencia en Bahías de Huatulco.</p>
                    <a asp-action="Crear" class="button button-gold rounded-pill px-4 py-2">
                        + Registrar Alojamiento
                    </a>
                </div>
            }
        </div>
    </div>
</div>
