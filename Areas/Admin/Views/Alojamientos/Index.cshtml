@model IEnumerable<Alojamiento>
@{
    ViewData["Title"] = "Administrar alojamientos";
}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="eyebrow text-primary">ADMINISTRACIÓN</span>
            <h1 class="h2 fw-bold">Alojamientos</h1>
        </div>
        <a asp-area="Admin" asp-controller="Alojamientos" asp-action="Crear" class="btn btn-primary">Nuevo alojamiento</a>
    </div>

    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="alert alert-success">@mensaje</div>
    }

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Nombre</th><th>Tipo</th><th>Capacidad</th><th>Precio / noche</th><th>Estado</th><th></th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold">@item.Nombre</td>
                    <td>@item.Tipo</td>
                    <td>@item.CapacidadHuespedes</td>
                    <td>@item.PrecioBasePorNoche.ToString("C")</td>
                    <td>@item.Estado</td>
                    <td class="text-end">
                        <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <form asp-action="Eliminar" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar este alojamiento?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
