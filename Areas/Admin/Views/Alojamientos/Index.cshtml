@model IEnumerable<Alojamiento>
@{ViewData["Title"]="Administrar alojamientos";bool inactive=ViewBag.IncluirInactivos==true;}
<div class="container py-5"><div class="d-flex justify-content-between align-items-center mb-4"><div><span class="eyebrow text-primary">ADMINISTRACIÓN</span><h1 class="h2 fw-bold">Alojamientos</h1></div><a asp-action="Crear" class="btn btn-primary">Nuevo alojamiento</a></div>@if(TempData["Mensaje"] is string msg){<div class="alert alert-success">@msg</div>}@if(inactive){<a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3">Ver activos</a>}else{<a asp-action="Index" asp-route-incluirInactivos="true" class="btn btn-sm btn-outline-secondary mb-3">Incluir inactivos</a>}<div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Nombre</th><th>Tipo</th><th>Capacidad</th><th>Precio/noche</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.Nombre</td><td>@a.Tipo</td><td>@a.CapacidadHuespedes</td><td>@a.PrecioBasePorNoche.ToString("C")</td><td>@(a.Activo?a.Estado.ToString():"Inactivo")</td><td class="text-end text-nowrap">@if(a.Activo){<a asp-action="Editar" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">Editar</a><form asp-action="Desactivar" asp-route-id="@a.Id" method="post" class="d-inline" onsubmit="return confirm('¿Desactivar? Se conservará el historial.');">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger">Desactivar</button></form>}</td></tr>}</tbody></table>@if(!Model.Any()){<p class="text-center text-muted py-4">No hay alojamientos registrados.</p>}</div></div>
