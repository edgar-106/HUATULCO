@model AlojamientoFormViewModel
@{
    var esEdicion = Model.Id.HasValue;
    ViewData["Title"] = esEdicion ? "Editar alojamiento" : "Nuevo alojamiento";
}
<div class="container py-5">
    <h1 class="h2 fw-bold mb-4">@ViewData["Title"]</h1>
    <form method="post" class="row g-3">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="col-md-8">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Tipo" class="form-label"></label>
            <select asp-for="Tipo" asp-items="Html.GetEnumSelectList<TipoAlojamiento>()" class="form-select"></select>
        </div>
        <div class="col-12">
            <label asp-for="Descripcion" class="form-label"></label>
            <textarea asp-for="Descripcion" rows="4" class="form-control"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="CapacidadHuespedes" class="form-label"></label>
            <input asp-for="CapacidadHuespedes" class="form-control" />
            <span asp-validation-for="CapacidadHuespedes" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="NumeroHabitaciones" class="form-label"></label>
            <input asp-for="NumeroHabitaciones" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="NumeroBanos" class="form-label"></label>
            <input asp-for="NumeroBanos" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="PrecioBasePorNoche" class="form-label"></label>
            <input asp-for="PrecioBasePorNoche" class="form-control" type="number" min="0.01" step="0.01" />
            <span asp-validation-for="PrecioBasePorNoche" class="text-danger"></span>
        </div>
        <div class="col-md-8">
            <label asp-for="Direccion" class="form-label"></label>
            <input asp-for="Direccion" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Latitud" class="form-label"></label>
            <input asp-for="Latitud" class="form-control" type="number" step="any" />
        </div>
        <div class="col-md-6">
            <label asp-for="Longitud" class="form-label"></label>
            <input asp-for="Longitud" class="form-control" type="number" step="any" />
        </div>
        <div class="col-md-6">
            <label asp-for="Estado" class="form-label"></label>
            <select asp-for="Estado" asp-items="Html.GetEnumSelectList<EstadoAlojamiento>()" class="form-select"></select>
        </div>
        <div class="col-12 d-flex gap-2 mt-4">
            <button class="btn btn-primary" type="submit">Guardar alojamiento</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
