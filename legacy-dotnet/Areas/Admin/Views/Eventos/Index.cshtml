@model IEnumerable<HuatulcoTravel.Models.Evento>
@{
    ViewData["Title"] = "Eventos";
    var alojamientos = (IEnumerable<HuatulcoTravel.Models.Alojamiento>)ViewData["Alojamientos"];
    var alojamientoSel = ViewData["AlojamientoId"] as Guid?;
    var tipoSel = ViewData["Tipo"] as HuatulcoTravel.Models.TipoEvento?;
    var esSporadicoSel = ViewData["EsSporadico"] as bool?;
}

<section class="section-wrap" style="padding-top: 48px;">
    <div class="section-heading mb-4">
        <div>
            <p class="eyebrow">PANEL ADMINISTRATIVO</p>
            <h2>Eventos y actividades</h2>
        </div>
        <a class="button button-gold" asp-area="Admin" asp-controller="Eventos" asp-action="Crear">
            <span>+</span> Registrar evento
        </a>
    </div>

    <div class="p-4 rounded-4 bg-white border shadow-sm mb-4">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-bold" for="fAlojamiento">Residencia</label>
                <select name="AlojamientoId" id="fAlojamiento" class="form-select">
                    <option value="">Todas las residencias</option>
                    @foreach (var a in alojamientos)
                    {
                        <option value="@a.Id" selected="@(alojamientoSel.HasValue && a.Id == alojamientoSel)">@a.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold" for="fTipo">Tipo de evento</label>
                <select name="Tipo" id="fTipo" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var t in Enum.GetValues<HuatulcoTravel.Models.TipoEvento>())
                    {
                        <option value="@t" selected="@(tipoSel.HasValue && t == tipoSel)">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold" for="fEsporadico">Modalidad</label>
                <select name="EsSporadico" id="fEsporadico" class="form-select">
                    <option value="">Todas</option>
                    <option value="true" selected="@(esSporadicoSel == true)">Esporádico</option>
                    <option value="false" selected="@(esSporadicoSel == false)">Fijo</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary">Filtrar</button>
                <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Eventos" asp-action="Index">Limpiar</a>
            </div>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-card">
            <span class="empty-icon">🎭</span>
            <h3>Sin eventos</h3>
            <p>No hay eventos registrados con los filtros seleccionados.</p>
        </div>
    }
    else
    {
        <div class="table-responsive rounded-4 border bg-white shadow-sm">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th>Modalidad</th>
                        <th>Residencia</th>
                        <th>Huésped</th>
                        <th>Fecha</th>
                        <th>Centro atractivo</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td><strong>@e.Nombre</strong></td>
                            <td>@e.Tipo</td>
                            <td>@(e.EsSporadico ? "Esporádico" : "Fijo")</td>
                            <td>@(e.Alojamiento?.Nombre ?? "Sin residencia")</td>
                            <td>@(e.Usuario?.Nombre ?? e.Usuario?.Email ?? "Sin huésped")</td>
                            <td>@e.Fecha</td>
                            <td>@(string.IsNullOrWhiteSpace(e.CentroAtractivo) ? "—" : e.CentroAtractivo)</td>
                            <td><span class="badge bg-secondary">@e.Estado</span></td>
                            <td class="text-end">
                                <form method="post" asp-area="Admin" asp-controller="Eventos" asp-action="Eliminar" class="d-inline">
                                    <input type="hidden" name="id" value="@e.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Eliminar este evento?');">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
