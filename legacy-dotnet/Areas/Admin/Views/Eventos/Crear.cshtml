@model HuatulcoTravel.Models.Evento
@{
    ViewData["Title"] = "Nuevo evento";
}

<section class="section-wrap" style="padding-top: 48px;">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="p-4 rounded-4 bg-white border shadow-sm">
                <div class="section-heading mb-4">
                    <div>
                        <p class="eyebrow">PANEL ADMINISTRATIVO</p>
                        <h2>Registrar evento</h2>
                    </div>
                </div>

                <form asp-area="Admin" asp-controller="Eventos" asp-action="Crear" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label small fw-bold" for="Nombre">Nombre del evento</label>
                        <input type="text" name="Nombre" id="Nombre" class="form-control" value="@Model.Nombre" required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold" for="Tipo">Tipo de evento</label>
                            <select name="Tipo" id="Tipo" class="form-select">
                                @foreach (var t in Enum.GetValues<HuatulcoTravel.Models.TipoEvento>())
                                {
                                    <option value="@t" selected="@(Model.Tipo == t)">@t</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold" for="Fecha">Fecha</label>
                            <input type="date" name="Fecha" id="Fecha" class="form-control" value="@Model.Fecha" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold" for="AlojamientoId">Residencia</label>
                            <select name="AlojamientoId" id="AlojamientoId" class="form-select">
                                @foreach (var a in (IEnumerable<HuatulcoTravel.Models.Alojamiento>)ViewData["Alojamientos"])
                                {
                                    <option value="@a.Id" selected="@(Model.AlojamientoId == a.Id)">@a.Nombre</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold" for="UsuarioId">Huésped (usuario)</label>
                            <select name="UsuarioId" id="UsuarioId" class="form-select">
                                <option value="">— Sin vínculo a usuario —</option>
                                @foreach (var u in (IEnumerable<HuatulcoTravel.Models.ApplicationUser>)ViewData["Usuarios"])
                                {
                                    <option value="@u.Id" selected="@(Model.UsuarioId == u.Id)">@u.Nombre @u.Apellidos (@u.Email)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold" for="EsSporadico">Modalidad</label>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="EsSporadico" id="EsSporadico" value="true" />
                                <label class="form-check-label small fw-bold" for="EsSporadico">Evento esporádico</label>
                </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold" for="Estado">Estado</label>
                            <select name="Estado" id="Estado" class="form-select">
                                @foreach (var e in Enum.GetValues<HuatulcoTravel.Models.EstadoEvento>())
                                {
                                    <option value="@e" selected="@(Model.Estado == e)">@e</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold" for="CentroAtractivo">Centro atractivo / proveedor externo</label>
                        <input type="text" name="CentroAtractivo" id="CentroAtractivo" class="form-control" value="@Model.CentroAtractivo" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold" for="Proveedor">Proveedor / operador</label>
                        <input type="text" name="Proveedor" id="Proveedor" class="form-control" value="@Model.Proveedor" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold" for="Descripcion">Descripción</label>
                        <textarea name="Descripcion" id="Descripcion" class="form-control" rows="3">@Model.Descripcion</textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-bold">Guardar evento</button>
                        <a class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-bold" asp-area="Admin" asp-controller="Eventos" asp-action="Index">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
